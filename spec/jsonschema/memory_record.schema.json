{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryRecord",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "subject_id",
    "created_at",
    "updated_at",
    "type",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string"
    },
    "content": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "embedding": {},
    "retention": {
      "type": "object"
    },
    "consent_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}